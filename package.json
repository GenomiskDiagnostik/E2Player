{
  "name": "e2player",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "simulator": "evenhub-simulator http://127.0.0.1:5173 --automation-port 9898",
    "check": "tsc --noEmit",
    "test": "node --test",
    "build": "npm run check && vite build --base ./",
    "pack": "npm run build && evenhub pack app.json dist -o e2player.ehpk --sdk-ver 0.0.16"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
